# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://jiugypsum.ng

# ── Email delivery for the quote + contact forms (REQUIRED) ───────────
# Without these the forms show an honest "unavailable" error instead of a
# fake success. Use the mailbox you want enquiries delivered to.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true          # true for port 465, false for 587 (STARTTLS)
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Jiugypsum Website <contact@jiugypsum.ng>"
MAIL_TO=contact@jiugypsum.ng

# ── Analytics (optional) ──────────────────────────────────────────────
# Leave blank to load no analytics at all.
NEXT_PUBLIC_GA_ID=
